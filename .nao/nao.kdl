recipe "default" {
  task "pnpm-install" description="Install pnpm workspace dependencies" {
    run shell="./t pnpm install --frozen-lockfile"
  }

  task "joix" description="Run the combined JOI example server" direct-output=#true {
    depends-on "codegen"
    run shell="./t cargo run -p joix"
  }

  task "ui" description="Run the Joi UI development server" {
    depends-on "pnpm-install"
    depends-on "codegen"
    run shell="""
      printf 'Task status: http://localhost:5173\n'
      exec ./t pnpm --dir ui dev
    """
  }

  task "dev" description="Run the combined JOI backend and UI" {
    depends-on "joix"
    depends-on "ui"
    run shell="printf 'Task outcome: development servers stopped\n'"
  }

  task "cargo-fmt" description="Check Rust formatting" {
    depends-on "codegen"
    run shell="./t cargo fmt --all -- --check"
  }

  task "cargo-clippy" description="Run Rust clippy" {
    depends-on "codegen"
    run shell="./t clippy --workspace --all-targets -- -D warnings"
  }

  task "cargo-test" description="Run Rust tests" {
    depends-on "codegen"
    run shell="./t cargo-nextest nextest run --workspace"
  }

  task "biome-lint" description="Run Biome linting" {
    depends-on "pnpm-install"
    depends-on "codegen"
    run shell="./t node ui/node_modules/@biomejs/biome/bin/biome lint codegen/src codegen/package.json codegen/tsconfig.json ui/src ui/vite.config.ts"
  }

  task "biome-format" description="Check Biome formatting" {
    depends-on "pnpm-install"
    depends-on "codegen"
    run shell="""
      paths="codegen/src codegen/tsconfig.json codegen/package.json ui/src ui/vite.config.ts ui/tsconfig.json ui/package.json biome.json"
      before=$(mktemp)
      trap 'rm -f "$before"' EXIT
      git diff --binary -- $paths > "$before"
      ./t node ui/node_modules/@biomejs/biome/bin/biome format --write $paths
      git diff --binary -- $paths | cmp -s "$before" -
    """
  }

  task "ui-typecheck" description="Run the UI TypeScript typecheck" {
    depends-on "pnpm-install"
    depends-on "codegen"
    run shell="./t node ui/node_modules/@typescript/native-preview/bin/tsgo --noEmit --project ui/tsconfig.json"
  }

  task "ui-test" description="Run the UI tests" {
    depends-on "pnpm-install"
    depends-on "codegen"
    run shell="./t node ui/node_modules/vitest/vitest.mjs run --root ui"
  }

  task "codegen-typecheck" description="Typecheck the TypeScript code generator" {
    depends-on "pnpm-install"
    run shell="./t node codegen/node_modules/@typescript/native-preview/bin/tsgo --noEmit --project codegen/tsconfig.json"
  }

  task "codegen-test" description="Run TypeScript code generator tests" {
    depends-on "pnpm-install"
    depends-on "codegen"
    run shell="./t node codegen/node_modules/vitest/vitest.mjs run --root codegen"
  }

  task "codegen" description="Generate shared API source files" {
    depends-on "pnpm-install"
    depends-on "codegen-typecheck"
    run shell="./t node codegen/src/cli.ts generate"
  }

  task "codegen-check" description="Check generated shared API source files" {
    depends-on "pnpm-install"
    depends-on "codegen"
    run shell="./t node codegen/src/cli.ts check"
  }

  task "codegen-clean" description="Remove all generated output folders" {
    depends-on "pnpm-install"
    run shell="./t node codegen/src/cli.ts clean"
  }

  task "check" description="Run all repository checks" {
    depends-on "codegen"
    depends-on "cargo-fmt"
    depends-on "cargo-clippy"
    depends-on "biome-lint"
    depends-on "biome-format"
    depends-on "ui-typecheck"
    depends-on "ui-test"
    depends-on "codegen-test"
    depends-on "codegen-check"
    run shell="printf 'Task outcome: repository checks passed\n'"
  }

  task "ci" description="Run continuous integration checks" {
    depends-on "check"
    depends-on "cargo-test"
    run shell="printf 'Task outcome: continuous integration checks passed\n'"
  }
}
