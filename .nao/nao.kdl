recipe "default" {
  task "joix-tickets" description="Run the joix-tickets testbed" direct-output=#true {
    run shell="cargo run --manifest-path examples/joix-tickets/Cargo.toml"
  }

  task "ui" description="Run the Joi UI development server" {
    run shell="""
      printf 'Task status: http://localhost:5173\n'
      cd ui
      exec pnpm dev
    """
  }

  task "dev" description="Run the joix-tickets backend and Joi UI" {
    depends-on "joix-tickets"
    depends-on "ui"
    run shell="printf 'Task outcome: development servers stopped\n'"
  }

  task "cargo-fmt" description="Check Rust formatting" {
    run shell="""
      cargo fmt --manifest-path libs-rust/joi-base/Cargo.toml -- --check
      cargo fmt --manifest-path libs-rust/joi-error/Cargo.toml -- --check
      cargo fmt --manifest-path libs-rust/joi-plugin/Cargo.toml -- --check
      cargo fmt --manifest-path libs-rust/joi-template/Cargo.toml --all -- --check
      cargo fmt --manifest-path libs-rust/joi-api/Cargo.toml --all -- --check
      cargo fmt --manifest-path examples/joix-tickets/Cargo.toml -- --check
    """
  }

  task "cargo-clippy" description="Run Rust clippy" {
    run shell="""
      cargo clippy --manifest-path libs-rust/joi-base/Cargo.toml --all-targets -- -D warnings
      cargo clippy --manifest-path libs-rust/joi-error/Cargo.toml --all-targets -- -D warnings
      cargo clippy --manifest-path libs-rust/joi-plugin/Cargo.toml --all-targets -- -D warnings
      cargo clippy --manifest-path libs-rust/joi-template/Cargo.toml --workspace --all-targets -- -D warnings
      cargo clippy --manifest-path libs-rust/joi-api/Cargo.toml --workspace --all-targets -- -D warnings
      cargo clippy --manifest-path examples/joix-tickets/Cargo.toml --all-targets -- -D warnings
    """
  }

  task "biome-lint" description="Run Biome linting" {
    run shell="cd ui && pnpm exec biome lint src vite.config.ts ../libs-rust/joi-api/api-docs-ui/src ../libs-rust/joi-api/api-docs-ui/vite.config.ts"
  }

  task "biome-format" description="Check Biome formatting" {
    run shell="""
      cd ui
      paths="src vite.config.ts tsconfig.json package.json ../libs-rust/joi-api/api-docs-ui/src ../libs-rust/joi-api/api-docs-ui/vite.config.ts ../libs-rust/joi-api/api-docs-ui/tsconfig.json ../libs-rust/joi-api/api-docs-ui/package.json ../biome.json"
      before=$(mktemp)
      trap 'rm -f "$before"' EXIT
      git diff --binary -- $paths > "$before"
      pnpm exec biome format --write $paths
      git diff --binary -- $paths | cmp -s "$before" -
    """
  }

  task "ui-typecheck" description="Run the UI TypeScript typecheck" {
    run shell="cd ui && pnpm check"
  }

  task "ui-test" description="Run the UI tests" {
    run shell="cd ui && pnpm test -- --run"
  }

  task "check" description="Run all repository checks" {
    depends-on "cargo-fmt"
    depends-on "cargo-clippy"
    depends-on "biome-lint"
    depends-on "biome-format"
    depends-on "ui-typecheck"
    depends-on "ui-test"
    run shell="printf 'Task outcome: repository checks passed\n'"
  }

  task "docs-dev" description="Run the API documentation development servers" {
    run shell="""
      cleanup() {
        kill "$api_pid" "$ui_pid" 2>/dev/null || true
        wait "$api_pid" "$ui_pid" 2>/dev/null || true
      }

      trap cleanup EXIT HUP INT TERM

      printf 'Task status: http://localhost:5173\n'

      (
        cd libs-rust/joi-api
        exec cargo run \
          --bin joi-api-docs-server \
          -- \
          examples/ticket.joi-api
      ) &
      api_pid=$!

      (
        cd libs-rust/joi-api/api-docs-ui
        exec pnpm dev
      ) &
      ui_pid=$!

      while kill -0 "$api_pid" 2>/dev/null && kill -0 "$ui_pid" 2>/dev/null; do
        sleep 1
      done

      status=0
      if ! kill -0 "$api_pid" 2>/dev/null; then
        wait "$api_pid" || status=$?
      else
        wait "$ui_pid" || status=$?
      fi
      exit "$status"
    """
  }
}
