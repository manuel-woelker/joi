tools {
	node "26.8.1" {
		download {
			windows "https://nodejs.org/dist/v${version}/node-v${version}-win-x64.zip"
			linux "https://nodejs.org/dist/v${version}/node-v${version}-linux-x64.tar.gz"
		}
		commands {
			node "${linux:bin/}node"
			npm "${linux:bin/}npm"
			npx "${linux:bin/}npx"
		}
		env {
			PATH "${dir:node}"
		}
	}
	pnpm "12.2.1" {
		download {
			windows "https://github.com/pnpm/pnpm/releases/download/v${version}/pnpm-win-x64.exe"
			linux "https://github.com/pnpm/pnpm/releases/download/v${version}/pnpm-linux-x64.tar.gz"
		}
		commands {
			pnpm "pnpm"
		}
	}
}